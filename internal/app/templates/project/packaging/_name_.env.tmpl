[[- if or .Deb .RPM -]]
# [[ .Name ]]'s settings: infrapi/lib's INFRAPI_APP_* keys, and [[ .EnvPrefix ]]_*.
# See internal/config.
INFRAPI_APP_NAME=[[ .Name ]]
INFRAPI_APP_PLATFORM=prod
INFRAPI_APP_REGION=eu-west-1
INFRAPI_APP_LOCATION=dc1
INFRAPI_APP_FQDN=[[ .Name ]].example.com
INFRAPI_APP_URL=https://[[ .Name ]].example.com
INFRAPI_APP_LISTEN_ADDRESS=127.0.0.1:8080
INFRAPI_APP_LOG_FORMAT=json

# Kayra, through the gateway
[[ .EnvPrefix ]]_AUTH_URL=https://api.example.com
[[ end -]]
