# [[ .Name ]]'s contract, version v1: what the API serves, checked on every
# request before a handler runs (server.WithOpenAPI), served at
# /apis/[[ .Group ]]/v1/-/openapi/[[ .Name ]]/v1.yaml and in /-/docs.
#
# infrapi-cli app add <resource> adds a resource's paths and schema. Edit
# it, then infrapi-cli app generate writes the Go code:
# api/zz_generated.go, the schemas as Go types, and
# internal/[[ .Name ]]/zz_generated.go, Handlers, one method per operation.
#
# info.title is the API's name, its Go package internal/<title>;
# info.x-infrapi-group its group: every path is under /apis/<group>/v1.
# Every operation has an operationId, its Go method's name.
openapi: 3.0.3
info:
  title: [[ .Name ]]
  version: v1
  x-infrapi-group: [[ .Group ]]
  description: The [[ .Name ]] API.

paths: {}

components:
  parameters:
    namespace:
      name: namespace
      in: path
      required: true
      description: The namespace, a tenant's or one of its teams'.
      schema: {type: string, pattern: '^[a-z0-9]([-a-z0-9]*[a-z0-9])?$', maxLength: 63}
    name:
      name: name
      in: path
      required: true
      description: The resource's name, unique in its namespace.
      schema: {type: string, pattern: '^[a-z0-9]([-a-z0-9]*[a-z0-9])?$', maxLength: 63}

  responses:
    Problem:
      description: An error, as a problem document (RFC 9457).
      content:
        application/problem+json:
          schema: {$ref: '#/components/schemas/Problem'}

  schemas:
    Problem:
      type: object
      description: An error, as infrapi/lib renders it.
      required: [status, title]
      properties:
        status: {type: integer, description: The HTTP status.}
        title: {type: string, description: The kind of problem.}
        detail: {type: string, description: This occurrence of it.}
        code: {type: string, description: A stable code to branch on.}
        solution: {type: string, description: What to do about it.}
        retryable: {type: boolean, description: Whether the same request may succeed later.}
