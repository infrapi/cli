// Package config is [[ .Name ]]'s settings, read from the dotenv file
// INFRAPI_CONFIG_DOTENV_FILE names (.env when unset): infrapi/lib's own
// INFRAPI_APP_* keys, and [[ .Name ]]'s, [[ .EnvPrefix ]]_*. infrapi-cli dev renders
// one for the dev stack, .infrapi-dev/app.env: infrapi-cli app run reads it.
package config

import (
	libconfig "github.com/infrapi/lib/pkg/config"
)

// Config is [[ .Name ]]'s settings.
type Config struct {
	// App is infrapi/lib's: the name, platform, listen address, logs,
	// CORS... (INFRAPI_APP_*).
	App *libconfig.AppConfig
	// AuthURL is Kayra's URL, through the gateway: [[ .EnvPrefix ]]_AUTH_URL.
	AuthURL string
	// Identity is the API's own identity at Kayra, system:api:[[ .Group ]]:
	// INFRAPI_IDENTITY_KEY_PATH, its key, or INFRAPI_IDENTITY_TOKEN_PATH, a
	// platform's token. None when neither is set.
	Identity libconfig.Identity
	// Events is how [[ .Name ]] records its events, INFRAPI_EVENTS_*: to
	// Kayra, as the API, when enabled; to its log otherwise.
	Events libconfig.Events
}

// Load reads the settings, and fails on a missing or invalid one.
func Load() (*Config, error) {
	vars, err := libconfig.NewConfig()
	if err != nil {
		return nil, err
	}
	app, err := vars.GetAppConfig()
	if err != nil {
		return nil, err
	}
	authURL, err := vars.GetString(&libconfig.VariableOpts{Key: "[[ .EnvPrefix ]]_AUTH_URL", Validator: "url"})
	if err != nil {
		return nil, err
	}
	identity, err := vars.GetIdentity()
	if err != nil {
		return nil, err
	}
	events, err := vars.GetEvents()
	if err != nil {
		return nil, err
	}

	// Your own settings are read the same way, a field of Config each:
	//
	//	region, err := vars.GetString(&libconfig.VariableOpts{
	//		Key: "[[ .EnvPrefix ]]_AWS_REGION", Default: "eu-west-1"})
	//	timeout, err := vars.GetDuration(&libconfig.VariableOpts{
	//		Key: "[[ .EnvPrefix ]]_TIMEOUT", Default: "30s"})
	//	token, err := vars.GetString(&libconfig.VariableOpts{
	//		Key: "[[ .EnvPrefix ]]_TOKEN", Sensible: true}) // never in an error or a log
	//	debug, err := vars.GetBool(&libconfig.VariableOpts{
	//		Key: "[[ .EnvPrefix ]]_DEBUG", Default: "false"})
	//
	// Validator takes a go-playground/validator rule (url, hostname, oneof=a b...).
	// Add them to dev.yaml's app.env to have them in .infrapi-dev/app.env.

	return &Config{App: app, AuthURL: authURL, Identity: identity, Events: events}, nil
}
