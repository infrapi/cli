// Command [[ .Name ]] serves the [[ .Name ]] API, /apis/[[ .Group ]]/<version>:
// its contracts, api/[[ .Name ]]-<version>.yaml, checked on every request,
// each one authenticated and authorized by Kayra. Its settings are read by
// internal/config.
package main

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/infrapi/lib/pkg/auth"
	"github.com/infrapi/lib/pkg/events"
	"github.com/infrapi/lib/pkg/identity"
	"github.com/infrapi/lib/pkg/listener"
	"github.com/infrapi/lib/pkg/logger"
	"github.com/infrapi/lib/pkg/server"

	"[[ .Module ]]/api"
	"[[ .Module ]]/internal/config"
	"[[ .Module ]]/internal/[[ .Name ]]"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	if err := run(ctx); err != nil {
		fmt.Fprintln(os.Stderr, "[[ .Name ]]:", err)
		os.Exit(1)
	}
}

func run(ctx context.Context) error {
	cfg, err := config.Load()
	if err != nil {
		return err
	}
	log, err := logger.New(logger.Options{Level: cfg.App.AppLogLevel.String(), Format: cfg.App.AppLogFormat, Name: "[[ .Name ]]"})
	if err != nil {
		return err
	}
	logger.SetDefault(log)
	defer func() { _ = logger.Sync() }()

	// Kayra answers who the caller is (cached) and whether they may act,
	// on every request. Its URL is all there is to configure: the rest is
	// in its /.well-known/kayra.json. PublicURL makes the API a resource
	// for OAuth clients, an MCP client say: a token of Kayra's
	// authorization server must be for it, and a 401 names its metadata.
	kayra, err := auth.NewClient(auth.ClientOptions{BaseURL: cfg.AuthURL, PublicURL: cfg.App.AppUrl})
	if err != nil {
		return err
	}
	// The API's own identity, system:api:[[ .Group ]]: its keys' public halves
	// at <root>/-/jwks.json, where Kayra reads them (app register sends
	// identity.jwks_from: spec). To call Kayra or another API as the API:
	//
	//	tokens, err := auth.NewClientCredentials(auth.ClientCredentialsOptions{
	//		Kayra: kayra, ClientID: identity.Subject("[[ .Group ]]"), Key: keys[0]})
	//	other, err := client.NewClient(&client.ClientOptions{..., TokenSource: tokens.Token})
	keys, err := identity.LoadKeys(cfg.Identity.KeyPaths)
	if err != nil {
		return err
	}
	// Its events: one for every write it serves (server.WithEvents), and
	// rec.Event(...) for what a worker does. They go to Kayra as the API
	// with INFRAPI_EVENTS_ENABLED, to the log otherwise.
	rec, err := newRecorder(cfg, kayra, keys)
	if err != nil {
		return err
	}
	defer func() {
		flush, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		_ = rec.Close(flush)
	}()
	// <root>/-/ (healthz, metrics, openapi.json, docs...) for each root, the
	// contracts checked before any handler runs
	engine, err := server.NewServerGin(cfg.App, api.Roots,
		server.WithAuth(kayra.Middleware()), server.WithOpenAPI(api.Contracts()...),
		server.WithProtectedResource(kayra.AuthorizationServer), server.WithIdentity(keys...),
		server.WithEvents(rec))
	if err != nil {
		return err
	}
	[[ .Name ]].Register(engine.Group("", kayra.RequireAccess()), [[ .Name ]].New())

	ln, err := listener.Listen(cfg.App)
	if err != nil {
		return err
	}
	srv := &http.Server{Handler: engine, ReadHeaderTimeout: 10 * time.Second}
	served := make(chan error, 1)
	go func() { served <- srv.Serve(ln) }()
	log.Info("serving", logger.String("address", ln.Addr().String()), logger.Any("roots", api.Roots),
		logger.String("auth", cfg.AuthURL), logger.Int("identity_keys", len(keys)))

	select {
	case err := <-served:
		return err
	case <-ctx.Done():
	}
	shutdown, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := srv.Shutdown(shutdown); err != nil && !errors.Is(err, http.ErrServerClosed) {
		return err
	}
	return nil
}

// newRecorder records [[ .Name ]]'s events: sent to Kayra with the API's own
// tokens when INFRAPI_EVENTS_ENABLED, written to the log otherwise.
func newRecorder(cfg *config.Config, kayra *auth.Client, keys []*identity.Key) (*events.Recorder, error) {
	o := events.Options{
		Controller: "[[ .Name ]]", Queue: cfg.Events.Queue, Batch: cfg.Events.Batch,
		SeriesWindow: cfg.Events.SeriesWindow, SpamBurst: cfg.Events.SpamBurst, SpamRefill: cfg.Events.SpamRefill,
	}
	if cfg.Events.Enabled {
		cc := auth.ClientCredentialsOptions{Kayra: kayra, ClientID: identity.Subject("[[ .Group ]]"), TokenFile: cfg.Identity.TokenPath}
		if len(keys) > 0 {
			cc.Key = keys[0]
		}
		tokens, err := auth.NewClientCredentials(cc)
		if err != nil {
			return nil, fmt.Errorf("INFRAPI_EVENTS_ENABLED needs the API's identity, INFRAPI_IDENTITY_KEY_PATH: %w", err)
		}
		o.Sender = events.Kayra(cfg.AuthURL, tokens.Token, nil)
	}
	return events.NewRecorder(o), nil
}
